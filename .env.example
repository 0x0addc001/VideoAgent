# Backend
VIDEOAGENT_ENVIRONMENT=development
VIDEOAGENT_DATABASE_URL=sqlite+aiosqlite:///./.data/videoagent.db
VIDEOAGENT_COOKIE_SECURE=false
VIDEOAGENT_SESSION_SECRET=replace-with-a-long-random-value
VIDEOAGENT_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-key
VIDEOAGENT_KLING_MCP_URL=https://kling.ai/mcp
# auto: use Kling when the user has connected an account, otherwise mock.
VIDEOAGENT_VIDEO_PROVIDER=auto
VIDEOAGENT_KLING_ACCESS_TOKEN=
VIDEOAGENT_CELERY_ENABLED=false
VIDEOAGENT_CELERY_BROKER_URL=redis://localhost:6379/0
VIDEOAGENT_CELERY_RESULT_BACKEND=redis://localhost:6379/1
VIDEOAGENT_LLM_BASE_URL=
VIDEOAGENT_LLM_API_KEY=
VIDEOAGENT_LLM_MODEL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

