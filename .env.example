# Backend
VIDEOAGENT_ENVIRONMENT=development
VIDEOAGENT_DATABASE_URL=sqlite+aiosqlite:///./.data/videoagent.db
VIDEOAGENT_COOKIE_SECURE=false
VIDEOAGENT_SESSION_SECRET=replace-with-a-long-random-value
VIDEOAGENT_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-key
VIDEOAGENT_ADMIN_EMAILS=["admin@example.com"]
VIDEOAGENT_REGISTRATION_MODE=open
VIDEOAGENT_GENERATION_ENABLED=true
# auto and pippit use the server-owned Pippit CLI; mock uses local sample media.
VIDEOAGENT_VIDEO_PROVIDER=pippit
VIDEOAGENT_KLING_BACKEND=cli
VIDEOAGENT_KLING_CLI_COMMAND=kling
VIDEOAGENT_KLING_CLI_TIMEOUT_SECONDS=180
VIDEOAGENT_KLING_EXPECTED_USER_ID=
VIDEOAGENT_PIPPIT_CLI_COMMAND=pippit-tool-cli
VIDEOAGENT_PIPPIT_VIDEO_MODEL=
VIDEOAGENT_PIPPIT_VIDEO_RESOLUTION=
VIDEOAGENT_PIPPIT_TIMEOUT_SECONDS=180
# Optional for CI. Prefer the CLI browser login on developer and production hosts.
VIDEOAGENT_PIPPIT_ACCESS_KEY=
VIDEOAGENT_CELERY_ENABLED=false
VIDEOAGENT_CELERY_BROKER_URL=redis://localhost:6379/0
VIDEOAGENT_CELERY_RESULT_BACKEND=redis://localhost:6379/1
# DeepSeek is OpenAI-compatible. Leave the key empty to use the local planner.
VIDEOAGENT_LLM_BASE_URL=https://api.deepseek.com/v1
VIDEOAGENT_LLM_API_KEY=
VIDEOAGENT_LLM_MODEL=deepseek-chat
VIDEOAGENT_MEDIA_DIR=.data/media
VIDEOAGENT_MAX_UPLOAD_BYTES=104857600
VIDEOAGENT_FFMPEG_COMMAND=ffmpeg
VIDEOAGENT_FFPROBE_COMMAND=ffprobe
VIDEOAGENT_STARTING_USER_CREDITS=0
VIDEOAGENT_AUTH_RATE_LIMIT_PER_MINUTE=20
VIDEOAGENT_GENERATION_RATE_LIMIT_PER_MINUTE=30
VIDEOAGENT_UPLOAD_RATE_LIMIT_PER_MINUTE=20

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

